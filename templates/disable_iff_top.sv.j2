{% from '_macros.sv.j2' import wire_type, port_decl with context %}
{% set body_has_overflow = body_overflow_port == "true" %}
// Generated by sva2rtl {{ sva2rtl_version }}
// Source: {{ source_loc }}
// Original property: @({{ clock_edge }} {{ clock_signal }}) {{ original_text }}
module {{ module_name }} (
{{ port_decl(verilog_mode, "input", clock_signal) }},
{{ port_decl(verilog_mode, "input", "rst_n") }},
{{ port_decl(verilog_mode, "input", "start") }},
{% for port_name, _ in observed_signals %}
{{ port_decl(verilog_mode, "input", port_name) }},
{% endfor %}
{{ port_decl(verilog_mode, "input", "disable_i") }},
{{ port_decl(verilog_mode, "output", "active") }},
{{ port_decl(verilog_mode, "output", "pass") }},
{{ port_decl(verilog_mode, "output", "fail") }},
{{ port_decl(verilog_mode, "output", "attempt_fired") }},
{{ port_decl(verilog_mode, "output", "disabled_o") }}{% if body_has_overflow %},{% endif %}
{% if body_has_overflow %}
{{ port_decl(verilog_mode, "output", "overflow_flag") }}
{% endif %}
);
    // ── Combinational disable condition ───────────────────────────────────────
    {{ wire_type(verilog_mode) }} cond_result;
    assign cond_result = ({{ cond_expr }});

    // ── Effective disable: local condition OR incoming disable_i ─────────────
    {{ wire_type(verilog_mode) }} effective_disable;
    assign effective_disable = disable_i | cond_result;

    // ── Body checker instantiation ────────────────────────────────────────────
    {{ children[0].module_name }} u_{{ children[0].module_name }} (
        .{{ clock_signal }}({{ clock_signal }}),
        .rst_n    (rst_n),
        .start    (start),
{% for port_name, _ in children[0].observed_signals %}
        .{{ port_name }}({{ port_name }}),
{% endfor %}
        .disable_i     (effective_disable),
        .active        (active),
        .pass          (pass),
        .fail          (fail),
        .attempt_fired (attempt_fired),
{% if body_has_overflow %}
        .overflow_flag (overflow_flag),
{% endif %}
        .disabled_o    ()
    );

    assign disabled_o = disable_i;

endmodule
