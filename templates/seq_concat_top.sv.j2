// Generated by sva2rtl {{ sva2rtl_version }}
// Source: {{ source_loc }}
// Original property: @({{ clock_edge }} {{ clock_signal }}) {{ original_text }}
module {{ module_name }} (
{% if verilog_mode %}
    input  {{ clock_signal }},
    input  rst_n,
    input  start,
{% for port_name, _ in observed_signals %}
    input  {{ port_name }},
{% endfor %}
    input  disable_i,
    output active,
    output pass,
    output fail,
    output attempt_fired,
    output disabled_o
{% else %}
    input  logic {{ clock_signal }},
    input  logic rst_n,
    input  logic start,
{% for port_name, _ in observed_signals %}
    input  logic {{ port_name }},
{% endfor %}
    input  logic disable_i,
    output logic active,
    output logic pass,
    output logic fail,
    output logic attempt_fired,
    output logic disabled_o
{% endif %}
);
    // ── Internal token wires (N+1 wires for N children) ─────────────────────
{% for child in children %}
{% if verilog_mode %}
    wire w_pass_{{ loop.index0 }};
    wire w_active_{{ loop.index0 }};
    wire w_fail_{{ loop.index0 }};
    wire w_afired_{{ loop.index0 }};
{% else %}
    logic w_pass_{{ loop.index0 }};
    logic w_active_{{ loop.index0 }};
    logic w_fail_{{ loop.index0 }};
    logic w_afired_{{ loop.index0 }};
{% endif %}
{% endfor %}

    // ── Child module instantiations (token-passing chain) ────────────────────
{% for child in children %}
{% if loop.first %}
    {{ child.module_name }} u_{{ child.module_name }}_{{ loop.index0 }} (
        .{{ clock_signal }}({{ clock_signal }}),
        .rst_n    (rst_n),
        .start    (start),
{% for port_name, _ in child.observed_signals %}
        .{{ port_name }}({{ port_name }}),
{% endfor %}
        .disable_i     (disable_i),
        .active        (w_active_{{ loop.index0 }}),
        .pass          (w_pass_{{ loop.index0 }}),
        .fail          (w_fail_{{ loop.index0 }}),
        .attempt_fired (w_afired_{{ loop.index0 }}),
        .disabled_o    ()
    );
{% else %}
    {{ child.module_name }} u_{{ child.module_name }}_{{ loop.index0 }} (
        .{{ clock_signal }}({{ clock_signal }}),
        .rst_n    (rst_n),
        .start    (w_pass_{{ loop.index0 - 1 }}),
{% for port_name, _ in child.observed_signals %}
        .{{ port_name }}({{ port_name }}),
{% endfor %}
        .disable_i     (disable_i),
        .active        (w_active_{{ loop.index0 }}),
        .pass          (w_pass_{{ loop.index0 }}),
        .fail          (w_fail_{{ loop.index0 }}),
        .attempt_fired (w_afired_{{ loop.index0 }}),
        .disabled_o    ()
    );
{% endif %}
{% endfor %}

    // ── Top-level output aggregation ─────────────────────────────────────────
    // active: any child is active
    assign active = disable_i ? 1'b0 : ({% for child in children %}w_active_{{ loop.index0 }}{% if not loop.last %} | {% endif %}{% endfor %});
    // pass: final child's pass output
    assign pass   = disable_i ? 1'b0 : w_pass_{{ children | length - 1 }};
    // fail: any child signals fail
    assign fail   = disable_i ? 1'b0 : ({% for child in children %}w_fail_{{ loop.index0 }}{% if not loop.last %} | {% endif %}{% endfor %});
    // attempt_fired: first child's attempt_fired (start of sequence)
    assign attempt_fired = w_afired_0;
    assign disabled_o    = disable_i;

endmodule
