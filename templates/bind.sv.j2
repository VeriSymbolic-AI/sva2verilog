// Generated by sva2rtl {{ sva2rtl_version }}
// Bind file for property: {{ module_name }}
// Source: {{ source_loc }}
//
// Instantiates the monitor module inside the DUT context so that DUT signals
// are automatically visible.  Outputs are left unconnected — connect to your
// testbench or coverage infrastructure as needed.
//
// Usage:
//   Add this file to your simulation/synthesis filelist after the monitor .sv.
bind {{ dut_module }} {{ module_name }} u_{{ module_name }} (
    .{{ clock_signal }}   ({{ clock_signal }}),
    .rst_n        (rst_n),
    .start        (1'b1),
{% for port_name, sig_name in observed_signals %}
    .{{ port_name }}({{ sig_name }}),
{% endfor %}
    .disable_i    (1'b0),
    .active       (),
    .pass         (),
    .fail         (),
    .attempt_fired(),
    .disabled_o   ()
);
