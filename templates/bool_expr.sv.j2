// Generated by sva2rtl {{ sva2rtl_version }}
// Source: {{ source_loc }}
// Original property: @({{ clock_edge }} {{ clock_signal }}) {{ original_text }}
module {{ module_name }} (
{% if verilog_mode %}
    input  {{ clock_signal }},
    input  rst_n,
    input  start,
{% for port_name, _ in observed_signals %}
    input  {{ port_name }},
{% endfor %}
    input  disable_i,
    output active,
    output pass,
    output fail,
    output attempt_fired,
    output disabled_o
{% else %}
    input  logic {{ clock_signal }},
    input  logic rst_n,
    input  logic start,
{% for port_name, _ in observed_signals %}
    input  logic {{ port_name }},
{% endfor %}
    input  logic disable_i,
    output logic active,
    output logic pass,
    output logic fail,
    output logic attempt_fired,
    output logic disabled_o
{% endif %}
);

    // ── Combinational evaluation ───────────────────────────────────────
{% if verilog_mode %}
    wire bool_result;
{% else %}
    logic bool_result;
{% endif %}
    assign bool_result = ({{ bool_expr }});

    // ── Registered outputs (OUT-02: no combinational glitches) ─────────
{% if verilog_mode %}
    reg active_q, pass_q, fail_q, attempt_fired_q;
    always @({{ clock_edge }} {{ clock_signal }}) begin
{% else %}
    logic active_q, pass_q, fail_q, attempt_fired_q;
    always_ff @({{ clock_edge }} {{ clock_signal }}) begin
{% endif %}
        if (!rst_n || disable_i) begin
            active_q        <= 1'b0;
            pass_q          <= 1'b0;
            fail_q          <= 1'b0;
            attempt_fired_q <= 1'b0;
        end else begin
            active_q        <= start;
            pass_q          <= start &  bool_result;
            fail_q          <= start & ~bool_result;
            attempt_fired_q <= attempt_fired_q | start;  // sticky
        end
    end

    assign active        = disable_i ? 1'b0 : active_q;
    assign pass          = disable_i ? 1'b0 : pass_q;
    assign fail          = disable_i ? 1'b0 : fail_q;
    assign attempt_fired = attempt_fired_q;
    assign disabled_o    = disable_i;

endmodule
