{% from '_macros.sv.j2' import port_decl, wire_type, signal_type with context %}
{% from '_attempt_fired_macro.sv.j2' import attempt_fired_logic with context %}
{% set clock_list = clocks.split(",") %}
// Generated by sva2rtl {{ sva2rtl_version }}
// Source: {{ source_loc }}
// Original property: @({{ clock_edge }} {{ clock_list[0] }}) {{ original_text }}
//
// Multi-clock top module.  Instantiates per-domain sub-checkers and 2-DFF
// synchronizers.  The token chain is wired by position: element N's pass
// feeds into element N+1's start (or sync token_i → sync token_o → element
// start when crossing a clock-domain boundary).
// See templates/sync_2dff.sv.j2 for the TRUSTED-COMPONENT statement.
module {{ module_name }} (
{% for clk in clock_list %}
{{ port_decl(verilog_mode, "input", clk) }},
{% endfor %}
{{ port_decl(verilog_mode, "input", "rst_n") }},
{{ port_decl(verilog_mode, "input", "start") }},
{% for port_name, _ in observed_signals %}
{{ port_decl(verilog_mode, "input", port_name) }},
{% endfor %}
{{ port_decl(verilog_mode, "input", "disable_i") }},
{{ port_decl(verilog_mode, "output", "active") }},
{{ port_decl(verilog_mode, "output", "pass") }},
{{ port_decl(verilog_mode, "output", "fail") }},
{{ port_decl(verilog_mode, "output", "attempt_fired") }},
{{ port_decl(verilog_mode, "output", "disabled_o") }}
);
{% set nc = children | length %}
    // ── Token-passing wires (pass/fail: nc+1 to cover start→all→final) ──
{% for i in range(nc + 1) %}
    {{ wire_type(verilog_mode) }} t{{ i }}_pass, t{{ i }}_fail;
{% endfor %}
    // ── Active wires: one per child; synchronizers are never active ──────────
{% for i in range(nc) %}
    {{ wire_type(verilog_mode) }} t{{ i }}_active;
{% endfor %}
    assign t0_pass = start;
    assign t0_fail = 1'b0;

{% for i in range(nc) %}
{% set c = children[i] %}
{% set cname = c.module_name ~ "_i" %}
{% if c.template_name == "sync_2dff" %}
    // ── 2-DFF synchronizer ({{ c.params.src_clock }} → {{ c.params.dst_clock }})
    {{ c.module_name }} {{ cname }} (
        .{{ c.params.src_clock }}({{ c.params.src_clock }}),
        .{{ c.params.dst_clock }}({{ c.params.dst_clock }}),
        .rst_n(rst_n),
        .disable_i(disable_i),
        .token_i(t{{ i }}_pass),
        .token_o(t{{ i+1 }}_pass)
    );
    assign t{{ i+1 }}_fail = t{{ i }}_fail;
    assign t{{ i }}_active = 1'b0;
{% else %}
{% set child_clk = c.params.get("clock_signal", clock_list[0]) %}
    // ── {{ i }} {{ c.module_name }} ({{ child_clk }} domain)
    {{ c.module_name }} {{ cname }} (
        .{{ child_clk }}({{ child_clk }}),
        .rst_n(rst_n),
        .start(t{{ i }}_pass),
{% for port_name, _ in c.observed_signals %}
        .{{ port_name }}({{ port_name }}),
{% endfor %}
        .disable_i(disable_i),
        .active(t{{ i }}_active),
        .pass(t{{ i+1 }}_pass),
        .fail(t{{ i+1 }}_fail),
        .attempt_fired(),
        .disabled_o()
    );
{% endif %}
{% endfor %}
    {{ signal_type(verilog_mode) }} attempt_fired_q;
{{ attempt_fired_logic(verilog_mode, clock_edge, clock_list[0], "start") }}

    assign active        = disable_i ? 1'b0 : ({% for i in range(nc) %}t{{ i }}_active{% if not loop.last %} | {% endif %}{% endfor %});
    assign pass          = disable_i ? 1'b0 : t{{ nc }}_pass;
    assign fail          = disable_i ? 1'b0 : t{{ nc }}_fail;
    assign attempt_fired = attempt_fired_q;
    assign disabled_o    = disable_i;
endmodule
