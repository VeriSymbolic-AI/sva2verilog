// Generated by sva2rtl {{ sva2rtl_version }}
// Source: {{ source_loc }}
// Original property: @({{ clock_edge }} {{ clock_signal }}) {{ original_text }}
module {{ module_name }} #(
    parameter DEPTH = {{ depth }}
) (
    input  logic {{ clock_signal }},
    input  logic rst_n,
    input  logic start,
    input  logic {{ signal_name }},
    input  logic disable_i,
    output logic active,
    output logic pass,
    output logic fail,
    output logic attempt_fired,
    output logic disabled_o
);

    // ── Shift-register pipeline (DEPTH stages = $past(sig, DEPTH)) ────────────
    logic attempt_fired_q;

{% if depth == "1" %}
    // Single-FF form for DEPTH=1 (common case)
    logic shift_q;

    always_ff @({{ clock_edge }} {{ clock_signal }}) begin
        if (!rst_n || disable_i) begin
            shift_q         <= 1'b0;
            attempt_fired_q <= 1'b0;
        end else begin
            shift_q         <= {{ signal_name }};
            attempt_fired_q <= attempt_fired_q | start;  // sticky
        end
    end

    logic past_value;
    assign past_value = shift_q;

{% else %}
    // Multi-FF shift register for DEPTH > 1
    logic [DEPTH-1:0] shift_q;

    always_ff @({{ clock_edge }} {{ clock_signal }}) begin
        if (!rst_n || disable_i) begin
            shift_q         <= '0;
            attempt_fired_q <= 1'b0;
        end else begin
            shift_q         <= {shift_q[DEPTH-2:0], {{ signal_name }}};
            attempt_fired_q <= attempt_fired_q | start;  // sticky
        end
    end

    logic past_value;
    assign past_value = shift_q[DEPTH-1];

{% endif %}

    // ── Output logic ──────────────────────────────────────────────────────────
    logic pass_internal;
    logic fail_internal;

    assign pass_internal = start & past_value;
    assign fail_internal = start & ~past_value;

    assign active        = disable_i ? 1'b0 : start;
    assign pass          = disable_i ? 1'b0 : pass_internal;
    assign fail          = disable_i ? 1'b0 : fail_internal;
    assign attempt_fired = attempt_fired_q;
    assign disabled_o    = disable_i;

endmodule
