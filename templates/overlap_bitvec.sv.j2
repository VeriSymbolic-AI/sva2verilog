module {{ module_name }} #(
    parameter BV_WIDTH = {{ bv_width }}
) (
{{ port_decl(verilog_mode, "input", clock_signal) }},
{{ port_decl(verilog_mode, "input", "rst_n") }},
{{ port_decl(verilog_mode, "input", "start") }},
{% for port_name, _ in observed_signals %}
{{ port_decl(verilog_mode, "input", port_name) }},
{% endfor %}
{{ port_decl(verilog_mode, "input", "disable_i") }},
{{ port_decl(verilog_mode, "output", "active") }},
{{ port_decl(verilog_mode, "output", "pass") }},
{{ port_decl(verilog_mode, "output", "fail") }},
{{ port_decl(verilog_mode, "output", "attempt_fired") }},
{{ port_decl(verilog_mode, "output", "overflow_flag") }},
{{ port_decl(verilog_mode, "output", "disabled_o") }}
);
    // ── Internal wires from child modules ────────────────────────────────────
    {{ wire_type(verilog_mode) }} ant_pass_w;
    {{ wire_type(verilog_mode) }} ant_active_w;
    {{ wire_type(verilog_mode) }} ant_fail_w;
    {{ wire_type(verilog_mode) }} ant_afired_w;
    {{ wire_type(verilog_mode) }} con_pass_w;
    {{ wire_type(verilog_mode) }} con_active_w;
    {{ wire_type(verilog_mode) }} con_fail_w;
    {{ wire_type(verilog_mode) }} con_afired_w;

    // ── Consequent start: driven from bit-vector oldest thread ────────────────
    {{ wire_type(verilog_mode) }} con_start_w;
    assign con_start_w = bv_q[BV_WIDTH-1];

    // ── Antecedent child instantiation ───────────────────────────────────────
    {{ children[0].module_name }} u_{{ children[0].module_name }} (
        .{{ clock_signal }}({{ clock_signal }}),
        .rst_n    (rst_n),
        .start    (start),
{% for port_name, _ in children[0].observed_signals %}
        .{{ port_name }}({{ port_name }}),
{% endfor %}
        .disable_i     (disable_i),
        .active        (ant_active_w),
        .pass          (ant_pass_w),
        .fail          (ant_fail_w),
        .attempt_fired (ant_afired_w),
        .disabled_o    ()
    );

    // ── Consequent child instantiation ───────────────────────────────────────
    {{ children[1].module_name }} u_{{ children[1].module_name }} (
        .{{ clock_signal }}({{ clock_signal }}),
        .rst_n    (rst_n),
        .start    (con_start_w),
{% for port_name, _ in children[1].observed_signals %}
        .{{ port_name }}({{ port_name }}),
{% endfor %}
        .disable_i     (disable_i),
        .active        (con_active_w),
        .pass          (con_pass_w),
        .fail          (con_fail_w),
        .attempt_fired (con_afired_w),
        .disabled_o    ()
    );

    // ── Bit-vector shift register (thread tracker) ────────────────────────────
    {% if verilog_mode %}
    reg [BV_WIDTH-1:0] bv_q;
    reg                overflow_flag_q;
    {% else %}
    logic [BV_WIDTH-1:0] bv_q;
    logic                overflow_flag_q;
    {% endif %}

    {{ wire_type(verilog_mode) }} overflow_event;
    assign overflow_event = ant_pass_w && (&bv_q) && !overflow_flag_q;

{{ always_block_header(verilog_mode, clock_edge, clock_signal) }}
        if (!rst_n || disable_i) begin
            bv_q            <= {{ zero_literal(verilog_mode) }};
            overflow_flag_q <= 1'b0;
        end else begin
            if (overflow_flag_q) begin
                bv_q            <= bv_q;
                overflow_flag_q <= 1'b1;
            end else begin
                overflow_flag_q <= overflow_flag_q | overflow_event;
{% if bv_width | int > 1 %}
                bv_q <= {ant_pass_w, bv_q[BV_WIDTH-1:1]};
{% else %}
                bv_q <= ant_pass_w;
{% endif %}
            end
        end
    end

    // ── HARDEN-01: attempt_fired_q never cleared by disable_i ──────────
    {{ wire_type(verilog_mode) }} attempt_fired_q;

{{ attempt_fired_logic(verilog_mode, clock_edge, clock_signal, "ant_pass_w") }}

    // ── Output assignments ────────────────────────────────────────────────────
    assign active        = disable_i ? 1'b0 : (overflow_flag_q ? 1'b0 : (ant_active_w | con_active_w | (|bv_q)));
    assign pass          = disable_i ? 1'b0 : (overflow_flag_q ? 1'b0 : (bv_q[BV_WIDTH-1] & con_pass_w));
    assign fail          = disable_i ? 1'b0 : (overflow_event  ? 1'b1 :
                           overflow_flag_q ? 1'b0 :
                           (bv_q[BV_WIDTH-1] & ~con_pass_w & con_start_w));
    assign attempt_fired = attempt_fired_q;
    assign overflow_flag = overflow_flag_q;
    assign disabled_o    = disable_i;

endmodule
