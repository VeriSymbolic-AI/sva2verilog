module {{ module_name }} #(
    parameter CNT_WIDTH = {{ cnt_width }}
) (
    input  logic {{ clock_signal }},
    input  logic rst_n,
    input  logic start,
{% for port_name, _ in observed_signals %}
    input  logic {{ port_name }},
{% endfor %}
    input  logic disable_i,
    output logic active,
    output logic pass,
    output logic fail,
    output logic attempt_fired,
    output logic disabled_o
);

    // ── Signal evaluation ────────────────────────────────────────────────────
    logic sig_eval;
    assign sig_eval = ({{ signal_expr }});

    // ── Counter-based consecutive repetition FSM ─────────────────────────────
    logic [CNT_WIDTH-1:0] count_q;
    logic                 running_q;
    logic                 attempt_fired_q;

    always_ff @({{ clock_edge }} {{ clock_signal }}) begin
        if (!rst_n || disable_i) begin
            count_q         <= '0;
            running_q       <= 1'b0;
            attempt_fired_q <= 1'b0;
        end else begin
            attempt_fired_q <= attempt_fired_q | start;  // sticky
            if (start && sig_eval) begin
                running_q <= 1'b1;
                count_q   <= {{ cnt_width }}'d1;
            end else if (running_q && sig_eval) begin
                if (count_q < {{ cnt_width }}'d{{ rep_max }})
                    count_q <= count_q + 1'b1;
            end else if (running_q && !sig_eval) begin
                running_q <= 1'b0;
                count_q   <= '0;
            end
        end
    end

    // ── Output logic ─────────────────────────────────────────────────────────
    logic pass_internal;
    logic fail_internal;
    logic active_internal;

    assign active_internal = running_q;
    assign pass_internal   = running_q && sig_eval &&
                             (count_q >= {{ cnt_width }}'d{{ rep_min }}) &&
                             (count_q <= {{ cnt_width }}'d{{ rep_max }});
    assign fail_internal   = running_q && !sig_eval &&
                             (count_q < {{ cnt_width }}'d{{ rep_min }});

    assign active        = disable_i ? 1'b0 : active_internal;
    assign pass          = disable_i ? 1'b0 : pass_internal;
    assign fail          = disable_i ? 1'b0 : fail_internal;
    assign attempt_fired = attempt_fired_q;
    assign disabled_o    = disable_i;

endmodule
