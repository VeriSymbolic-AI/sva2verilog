    logic running_q;
    {% endif %}

{{ always_block_header(verilog_mode, clock_edge, clock_signal) }}
        if (!rst_n || disable_i) begin
            count_q   <= {{ zero_literal(verilog_mode) }};
            running_q <= 1'b0;
        end else begin
            if (start && sig_eval) begin
                running_q <= 1'b1;
                count_q   <= {{ cnt_width }}'d1;
            end else if (running_q && sig_eval) begin
                if (count_q < {{ cnt_width }}'d{{ rep_max }})
                    count_q <= count_q + 1'b1;
            end else if (running_q && !sig_eval) begin
                running_q <= 1'b0;
                count_q   <= {{ zero_literal(verilog_mode) }};
            end
        end
    end

    // ── HARDEN-01: attempt_fired_q never cleared by disable_i ──────────
    {{ wire_type(verilog_mode) }} attempt_fired_q;
{{ attempt_fired_logic(verilog_mode, clock_edge, clock_signal, "start") }}

    // ── Output logic ─────────────────────────────────────────────────────────
    {{ wire_type(verilog_mode) }} pass_internal;
    {{ wire_type(verilog_mode) }} fail_internal;
    {{ wire_type(verilog_mode) }} active_internal;

    assign active_internal = running_q;
    assign pass_internal   = running_q && sig_eval &&
                             (count_q >= {{ cnt_width }}'d{{ rep_min }});
    assign fail_internal   = running_q && !sig_eval &&
                             (count_q < {{ cnt_width }}'d{{ rep_min }});

    assign active        = disable_i ? 1'b0 : active_internal;
    assign pass          = disable_i ? 1'b0 : pass_internal;
    assign fail          = disable_i ? 1'b0 : fail_internal;
