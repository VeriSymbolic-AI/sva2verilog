{% from '_macros.sv.j2' import signal_type, wire_type, port_decl, always_block_header, zero_literal with context %}
{% from '_attempt_fired_macro.sv.j2' import attempt_fired_logic with context %}
// Generated by sva2rtl {{ sva2rtl_version }}
// Source: {{ source_loc }}
// Original property: @({{ clock_edge }} {{ clock_signal }}) {{ original_text }}
module {{ module_name }} #(
    parameter CNT_WIDTH = {{ cnt_width }}
) (
{{ port_decl(verilog_mode, "input", clock_signal) }},
{{ port_decl(verilog_mode, "input", "rst_n") }},
{{ port_decl(verilog_mode, "input", "start") }},
{{ port_decl(verilog_mode, "input", "disable_i") }},
{{ port_decl(verilog_mode, "output", "active") }},
{{ port_decl(verilog_mode, "output", "pass") }},
{{ port_decl(verilog_mode, "output", "fail") }},
{{ port_decl(verilog_mode, "output", "attempt_fired") }},
{{ port_decl(verilog_mode, "output", "disabled_o") }}
);
{% if delay_min == "0" and delay_max == "0" %}
    // ── ##0 combinational pass-through ──────────────────────────────────────
    assign pass   = disable_i ? 1'b0 : start;
    assign active = disable_i ? 1'b0 : start;
    assign fail   = 1'b0;

    // ── HARDEN-01: attempt_fired_q never cleared by disable_i ──────────
    {{ signal_type(verilog_mode) }} attempt_fired_q;

{{ attempt_fired_logic(verilog_mode, clock_edge, clock_signal, "start") }}
    assign attempt_fired = attempt_fired_q;
    assign disabled_o    = disable_i;
{% else %}
    // ── Counter-based delay ──────────────────────────────────────────────────
    {% if verilog_mode %}
    reg [CNT_WIDTH-1:0] count_q;
    reg                 running_q;
    {% else %}
    logic [CNT_WIDTH-1:0] count_q;
    logic                 running_q;
    {% endif %}

{{ always_block_header(verilog_mode, clock_edge, clock_signal) }}
        if (!rst_n || disable_i) begin
            count_q         <= {{ zero_literal(verilog_mode) }};
            running_q       <= 1'b0;
        end else begin
            if (start) begin
                count_q   <= {{ zero_literal(verilog_mode) }};
                running_q <= 1'b1;
            end else if (running_q) begin
                if (count_q == {{ cnt_width }}'d{{ delay_max }}) begin
                    running_q <= 1'b0;
                end else begin
                    count_q <= count_q + 1'b1;
                end
            end
        end
    end

    // ── HARDEN-01: attempt_fired_q never cleared by disable_i ──────────
    {{ signal_type(verilog_mode) }} attempt_fired_q;

{{ attempt_fired_logic(verilog_mode, clock_edge, clock_signal, "start") }}

{# BUG-DELAY-01 fix: the net a->b sample gap must equal the operator delay N.
   In the chain bool_expr(a) -> concat_delay -> bool_expr(b), the a-leaf registers
   (a-token arrives 1 cycle after a is sampled) and b is sampled on the cycle THIS
   module asserts pass, so gap = (pass_cycle - start_cycle) + 1. To make gap = N we
   assert pass at start+(N-1). count_q == k is visible at start+1+k, so a target
   cycle start+(N-1) is count_q == N-2; ranged delays use count_q in [M-2, N-2]. A
   target at the start cycle itself (M<=1<=N) is fired combinationally. The genuine
   fusion case (gap 0: ##0 or M==0) is unreachable through registered leaves and
   retains the legacy +1 (documented limitation). Inlined as a continuous assign —
   a `logic x = expr;` declaration would be a one-time initial value, not a
   continuous assignment. #}
{% set _emin = delay_min | int %}
{% set _emax = delay_max | int %}
{% set _cmin = [_emin - 2, 0] | max %}
{% set _cmax = [_emax - 2, 0] | max %}
    assign active        = disable_i ? 1'b0 : running_q;
    assign pass          = disable_i ? 1'b0 : (
                               (start && ({{ _emin }} <= 1) && ({{ _emax }} >= 1))
{% if _emax >= 2 %}                               || (running_q && {% if _cmin > 0 %}(count_q >= {{ cnt_width }}'d{{ _cmin }}) && {% endif %}(count_q <= {{ cnt_width }}'d{{ _cmax }}))
{% endif %}                           );
    assign fail          = 1'b0;
    assign attempt_fired = attempt_fired_q;
    assign disabled_o    = disable_i;
{% endif %}
endmodule
