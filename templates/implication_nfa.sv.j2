{% from '_macros.sv.j2' import signal_type, wire_type, port_decl, always_block_header with context %}
{% from '_attempt_fired_macro.sv.j2' import attempt_fired_logic with context %}
// Generated by sva2rtl {{ sva2rtl_version }}
// Source: {{ source_loc }}
// Original property: @({{ clock_edge }} {{ clock_signal }}) {{ original_text }}
//
// v1.5.1 P2 — NFA-based implication.
//   ant = {{ ant_guard }}  (single-cycle antecedent, combinational)
//   con = nfa_generic       (multi-cycle consequent NFA, property-kind)
//   op  = {{ op_type }}     (|-> overlapping / |=> non-overlapping)
//   T   = {{ nfa_thread_slots }}
module {{ module_name }} (
{{ port_decl(verilog_mode, "input", clock_signal) }},
{{ port_decl(verilog_mode, "input", "rst_n") }},
{{ port_decl(verilog_mode, "input", "start") }},
{% for port_name, _ in observed_signals %}
{{ port_decl(verilog_mode, "input", port_name) }},
{% endfor %}
{{ port_decl(verilog_mode, "input", "disable_i") }},
{{ port_decl(verilog_mode, "output", "active") }},
{{ port_decl(verilog_mode, "output", "pass") }},
{{ port_decl(verilog_mode, "output", "fail") }},
{{ port_decl(verilog_mode, "output", "attempt_fired") }},
{{ port_decl(verilog_mode, "output", "disabled_o") }}
);

    // ── Antecedent match (combinational) ──────────────────────────────
    // Evaluates on the SAME cycle as `start`. Avoids the registered
    // pipeline issue that afflicted the old overlap_bitvec bv_q path.
    wire ant_match;
{% if overlapping %}
    assign ant_match = start & ({{ ant_guard }});
{% else %}
    // |=> : check ant at cycle s, consequent starts at cycle s+1.
    wire ant_at_s;
    assign ant_at_s = start & ({{ ant_guard }});
    {{ signal_type(verilog_mode) }} ant_s_q;
{{ always_block_header(verilog_mode, clock_edge, clock_signal) }}
        if (!rst_n) ant_s_q <= 1'b0;
        else        ant_s_q <= ant_at_s;
    end
    assign ant_match = ant_s_q;
{% endif %}

    // ── Consequent NFA (property-kind, multi-thread) ──────────────────
    {{ wire_type(verilog_mode) }} con_active, con_pass_w, con_fail_w, con_afired_w, con_disabled_w;
    {{ children[0].module_name }} u_con (
        .{{ clock_signal }}({{ clock_signal }}),
        .rst_n    (rst_n),
        .start    (ant_match),
{% for port_name, _ in children[0].observed_signals %}
        .{{ port_name }}({{ port_name }}),
{% endfor %}
        .disable_i     (disable_i),
        .active        (con_active),
        .pass          (con_pass_w),
        .fail          (con_fail_w),
        .attempt_fired (con_afired_w),
        .disabled_o    (con_disabled_w)
    );

    // ── Implication verdict ──────────────────────────────────────────
    // NFA started from ant_match — if ant never matched, NFA is idle
    // (state_q = 0) and pass/fail are 0. The NFA itself already registers
    // its outputs (pass_q, fail_q inside nfa_generic), so we wire them
    // directly without adding a second register.
    assign active        = disable_i ? 1'b0 : con_active;
    assign pass          = disable_i ? 1'b0 : con_pass_w;
    assign fail          = disable_i ? 1'b0 : con_fail_w;
    assign disabled_o    = disable_i ? 1'b1 : con_disabled_w;

    // ── attempt_fired ────────────────────────────────────────────────
    {{ signal_type(verilog_mode) }} attempt_fired_q;
{{ attempt_fired_logic(verilog_mode, clock_edge, clock_signal, "start") }}
    assign attempt_fired = attempt_fired_q;

endmodule
