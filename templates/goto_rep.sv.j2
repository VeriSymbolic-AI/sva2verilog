{% from '_macros.sv.j2' import signal_type, wire_type, port_decl, always_block_header, zero_literal with context %}
{% from '_attempt_fired_macro.sv.j2' import attempt_fired_logic with context %}
// Generated by sva2rtl {{ sva2rtl_version }}
// Source: {{ source_loc }}
// Original property: @({{ clock_edge }} {{ clock_signal }}) {{ original_text }}
module {{ module_name }} #(
    parameter CNT_WIDTH = {{ cnt_width }}
) (
{{ port_decl(verilog_mode, "input", clock_signal) }},
{{ port_decl(verilog_mode, "input", "rst_n") }},
{{ port_decl(verilog_mode, "input", "start") }},
{% for port_name, _ in observed_signals %}
{{ port_decl(verilog_mode, "input", port_name) }},
{% endfor %}
{{ port_decl(verilog_mode, "input", "disable_i") }},
{{ port_decl(verilog_mode, "output", "active") }},
{{ port_decl(verilog_mode, "output", "pass") }},
{{ port_decl(verilog_mode, "output", "fail") }},
{{ port_decl(verilog_mode, "output", "attempt_fired") }},
{{ port_decl(verilog_mode, "output", "disabled_o") }}
);
    // ── Signal evaluation ────────────────────────────────────────────────────
    {{ wire_type(verilog_mode) }} sig_eval;
    assign sig_eval = ({{ signal_expr }});

    // ── Goto repetition [->N]: count non-consecutive occurrences ──────────────
    // Matches when sig has been true N times (not necessarily consecutively).
    // Once matched, stays in pass state (locked).
    {% if verilog_mode %}
    reg [CNT_WIDTH-1:0] count_q;
    reg passed_q;
    {% else %}
    logic [CNT_WIDTH-1:0] count_q;
    logic passed_q;
    {% endif %}

{{ always_block_header(verilog_mode, clock_edge, clock_signal) }}
        if (!rst_n || disable_i) begin
            count_q   <= {{ zero_literal(verilog_mode) }};
            passed_q  <= 1'b0;
        end else if (start && !passed_q) begin
            if (sig_eval && count_q < {{ cnt_width }}'d{{ rep_max }})
                count_q <= count_q + 1'b1;
            if (sig_eval && count_q == {{ cnt_width }}'d{{ rep_max }} - 1)
                passed_q <= 1'b1;
        end
    end

    // ── HARDEN-01 ────────────────────────────────────────────────────────────
    {{ signal_type(verilog_mode) }} attempt_fired_q;
{{ attempt_fired_logic(verilog_mode, clock_edge, clock_signal, "start") }}

    // ── Output logic ──────────────────────────────────────────────────────────
    {{ wire_type(verilog_mode) }} pass_internal;
    {{ wire_type(verilog_mode) }} fail_internal;

    assign pass_internal = passed_q;
    assign fail_internal = 1'b0;  // [->N] never fails, only waits

    assign active        = disable_i ? 1'b0 : (start && !passed_q);
    assign pass          = disable_i ? 1'b0 : pass_internal;
    assign fail          = disable_i ? 1'b0 : fail_internal;
    assign attempt_fired = attempt_fired_q;
    assign disabled_o    = disable_i;

endmodule
