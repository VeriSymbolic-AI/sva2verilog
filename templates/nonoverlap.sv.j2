    // ── Consequent child instantiation ───────────────────────────────────────
    {{ children[1].module_name }} u_{{ children[1].module_name }} (
        .{{ clock_signal }}({{ clock_signal }}),
        .rst_n    (rst_n),
        .start    (con_start_w),
{% for port_name, _ in children[1].observed_signals %}
        .{{ port_name }}({{ port_name }}),
{% endfor %}
        .disable_i     (disable_i),
        .active        (con_active_w),
        .pass          (con_pass_w),
        .fail          (con_fail_w),
        .attempt_fired (con_afired_w),
        .disabled_o    ()
    );

    // ── 1-cycle delay register for |=> non-overlapping semantics ─────────────
    // ant_pass_delayed_q captures ant_pass_w; bit insertion uses delayed version
    // so consequent evaluation begins the cycle AFTER the antecedent matches.
{% if verilog_mode %}
    reg ant_pass_delayed_q;

    // ── Bit-vector shift register (thread tracker) ────────────────────────────
    reg [BV_WIDTH-1:0] bv_q;
    reg                overflow_flag_q;
    reg                attempt_fired_q;

    // Overflow: delayed antecedent fires while all bit positions occupied
    wire overflow_event;
    assign overflow_event = ant_pass_delayed_q && (&bv_q) && !overflow_flag_q;

    always @({{ clock_edge }} {{ clock_signal }}) begin
        if (!rst_n || disable_i) begin
            ant_pass_delayed_q <= 1'b0;
            bv_q               <= 0;
            overflow_flag_q    <= 1'b0;
            attempt_fired_q    <= 1'b0;
        end else begin
            ant_pass_delayed_q <= ant_pass_w;  // 1-cycle pipeline delay
            attempt_fired_q    <= attempt_fired_q | ant_pass_w;  // sticky
            if (overflow_flag_q) begin
                // HARD HALT: freeze bv_q, only rst_n clears
                bv_q            <= bv_q;
                overflow_flag_q <= 1'b1;
            end else begin
                overflow_flag_q <= overflow_flag_q | overflow_event;
                // Shift right (all threads age by 1), insert new thread at MSB
                // using DELAYED antecedent pass (1-cycle offset for |=>)
{% if bv_width | int > 1 %}
                bv_q <= {ant_pass_delayed_q, bv_q[BV_WIDTH-1:1]};
{% else %}
                bv_q <= ant_pass_delayed_q;
{% endif %}
            end
        end
    end
{% else %}
    logic ant_pass_delayed_q;

    // ── Bit-vector shift register (thread tracker) ────────────────────────────
    logic [BV_WIDTH-1:0] bv_q;
    logic                overflow_flag_q;
    logic                attempt_fired_q;

    // Overflow: delayed antecedent fires while all bit positions occupied
    logic overflow_event;
    assign overflow_event = ant_pass_delayed_q && (&bv_q) && !overflow_flag_q;

    always_ff @({{ clock_edge }} {{ clock_signal }}) begin
        if (!rst_n || disable_i) begin
            ant_pass_delayed_q <= 1'b0;
            bv_q               <= '0;
            overflow_flag_q    <= 1'b0;
            attempt_fired_q    <= 1'b0;
        end else begin
            ant_pass_delayed_q <= ant_pass_w;  // 1-cycle pipeline delay
            attempt_fired_q    <= attempt_fired_q | ant_pass_w;  // sticky
            if (overflow_flag_q) begin
                // HARD HALT: freeze bv_q, only rst_n clears
                bv_q            <= bv_q;
                overflow_flag_q <= 1'b1;
            end else begin
                overflow_flag_q <= overflow_flag_q | overflow_event;
                // Shift right (all threads age by 1), insert new thread at MSB
                // using DELAYED antecedent pass (1-cycle offset for |=>)
{% if bv_width | int > 1 %}
                bv_q <= {ant_pass_delayed_q, bv_q[BV_WIDTH-1:1]};
{% else %}
                bv_q <= ant_pass_delayed_q;
{% endif %}
