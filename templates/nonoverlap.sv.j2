    input  rst_n,
    input  start,
{% for port_name, _ in observed_signals %}
    input  {{ port_name }},
{% endfor %}
    input  disable_i,
    output active,
    output pass,
    output fail,
    output attempt_fired,
    output overflow_flag,
    output disabled_o
{% else %}
    input  logic {{ clock_signal }},
    input  logic rst_n,
    input  logic start,
{% for port_name, _ in observed_signals %}
    input  logic {{ port_name }},
{% endfor %}
    input  logic disable_i,
