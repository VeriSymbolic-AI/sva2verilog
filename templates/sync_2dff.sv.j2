{% from '_macros.sv.j2' import port_decl, always_block_header with context %}
// ─────────────────────────────────────────────────────────────────────────────
// TRUSTED COMPONENT: 2-DFF token synchronizer with optional metastability
// injection (v1.4.2 Path Two).
//
// This module crosses a single-bit token (match → start) from its source clock
// domain to the destination clock domain. It consists of exactly two flip-flops
// in series on the destination clock — the standard industry synchronizer for
// single-bit CDC (clock domain crossing) signals.
//
// IMPORTANT BOUNDARY: this is a level synchronizer, not an acknowledged pulse
// transfer. A token narrower than the destination sampling interval can be
// missed, and multiple source events can coalesce. The current compiler does
// not enforce a minimum token width or event rate. Treat generated multi-clock
// monitors as a trusted/prototype boundary until a handshake or toggle protocol
// and asynchronous clock-ratio tests are implemented.
//
// When META_ENABLE=0 (default): behaviour is identical to v1.4.1 — two FFs,
// no injection, deterministic output.
//
// When META_ENABLE=1: an 8-bit Galois LFSR (pure synthesizable RTL, identical
// output across iverilog / Verilator) drives a configurable-probability bit-flip
// on the synchronizer output. The LFSR seed is per-instance, derived from the
// module name, so each sync_2dff instance produces its own deterministic but
// uncorrelated injection phase. Injection occurs once per 255-cycle nonzero
// LFSR period; a zero seed is replaced with 8'hA5.
//
// WARNING: This synchronizer has NOT been verified against metastability via
// formal methods (yosys equiv_induct assumes single-clock synchronous logic).
// FPGA prototype or silicon post-silicon validation is recommended to confirm
// the timing assumptions (mean time between failure, clock frequency ratios).
// See SUPPORTED_CONSTRUCTS.md for the multi-clock verification boundary.
//
// Reference: semify-eda dynamic_cdc (MIT license) — deterministic LFSR-based
// metastability injection for CDC simulation.
//
// Generated by sva2rtl {{ sva2rtl_version }}
// ─────────────────────────────────────────────────────────────────────────────
module {{ module_name }} #(
    parameter META_ENABLE = 0,
    parameter [7:0] LFSR_SEED = 8'h{{ lfsr_seed or "A5" }}
) (
{{ port_decl(verilog_mode, "input", src_clock) }},
{{ port_decl(verilog_mode, "input", dst_clock) }},
{{ port_decl(verilog_mode, "input", "rst_n") }},
{{ port_decl(verilog_mode, "input", "disable_i") }},
{{ port_decl(verilog_mode, "input", "token_i") }},
{{ port_decl(verilog_mode, "output", "token_o") }}
);
    // Standard 2-flip-flop synchronizer for single-bit CDC.  The first flip-
    // flop samples the source-domain token (potentially metastable); the second
    // resolves the value to the destination domain with one cycle of additional
    // latency.  Total latency: 2 destination-clock cycles.
    {% if verilog_mode %}
    reg sync0_q, sync1_q;
    {% else %}
    logic sync0_q, sync1_q;
    {% endif %}

{{ always_block_header(verilog_mode, "posedge", dst_clock) }}
        if (!rst_n || disable_i) begin
            sync0_q <= 1'b0;
            sync1_q <= 1'b0;
        end else begin
            sync0_q <= token_i;
            sync1_q <= sync0_q;
        end
    end

    // ── Optional deterministic metastability injection (v1.4.2 Path Two) ────
    // When META_ENABLE=1, an 8-bit Galois LFSR emits one event per 255-cycle
    // nonzero period and inverts the synchronizer output for that dst-clock
    // cycle. The LFSR is pure RTL (no $random) → identical across iverilog /
    // The result is identical in Verilator for the same LFSR_SEED.
    generate
        if (META_ENABLE) begin : gen_meta_inject
{% if verilog_mode %}
            wire lfsr_bit;
{% else %}
            logic lfsr_bit;
{% endif %}
            lfsr_8bit #(.SEED(LFSR_SEED)) u_lfsr (
                .clk({{ dst_clock }}),
                .rst_n(rst_n),
                .lfsr_out(lfsr_bit)
            );
            assign token_o = disable_i ? 1'b0 : (sync1_q ^ lfsr_bit);
        end else begin : gen_no_inject
            assign token_o = disable_i ? 1'b0 : sync1_q;
        end
    endgenerate
endmodule
