// Original property: @({{ clock_edge }} {{ clock_signal }}) {{ original_text }}
// Specialized bounded-delay implication: ##[{{ delay_min }}:{{ delay_max }}]
module {{ module_name }} (
{{ port_decl(verilog_mode, "input", clock_signal) }},
{{ port_decl(verilog_mode, "input", "rst_n") }},
{{ port_decl(verilog_mode, "input", "start") }},
{% for port_name, _ in observed_signals %}
{{ port_decl(verilog_mode, "input", port_name) }},
{% endfor %}
{{ port_decl(verilog_mode, "input", "disable_i") }},
{{ port_decl(verilog_mode, "output", "active") }},
{{ port_decl(verilog_mode, "output", "pass") }},
{{ port_decl(verilog_mode, "output", "fail") }},
{{ port_decl(verilog_mode, "output", "overflow_flag") }},
{{ port_decl(verilog_mode, "output", "attempt_fired") }},
{{ port_decl(verilog_mode, "output", "disabled_o") }}
);

    localparam MAX_DELAY = {{ delay_max }};
    wire ant_at_s;
    assign ant_at_s = start & ({{ ant_guard }});
{% if overlapping %}
    wire trigger;
    assign trigger = ant_at_s;
{% else %}
    {{ signal_type(verilog_mode) }} ant_s_q;
{{ always_block_header(verilog_mode, clock_edge, clock_signal) }}
        if (!rst_n || disable_i) ant_s_q <= 1'b0;
        else                    ant_s_q <= ant_at_s;
    end
    wire trigger;
    assign trigger = ant_s_q;
{% endif %}

    // pending_q[i] is an obligation at age i+1.  One bit per age is
    // sufficient even with a trigger every cycle; there can be at most one new
    // assertion attempt per sampled clock edge.
    {{ signal_type(verilog_mode) }} [MAX_DELAY-1:0] pending_q;
    localparam [MAX_DELAY-1:0] ELIGIBLE_MASK = {{ delay_max }}'b{{ eligible_bits }};
    wire consequent_match;
    assign consequent_match = ({{ consequent_guard }});
    wire [MAX_DELAY-1:0] retire_mask;
    assign retire_mask = pending_q & ELIGIBLE_MASK & {MAX_DELAY{consequent_match}};

    wire [MAX_DELAY-1:0] pending_d;
    assign pending_d[0] = trigger;
{% for i in range(1, delay_max | int) %}
    assign pending_d[{{ i }}] = pending_q[{{ i - 1 }}] & ~retire_mask[{{ i - 1 }}];
{% endfor %}

    wire pass_d;
    wire fail_d;
    assign pass_d = |retire_mask;
    assign fail_d = pending_q[MAX_DELAY-1] & ~consequent_match;

    {{ signal_type(verilog_mode) }} pass_q, fail_q;
{{ always_block_header(verilog_mode, clock_edge, clock_signal) }}
        if (!rst_n || disable_i) begin
            pending_q <= {MAX_DELAY{1'b0}};
            pass_q    <= 1'b0;
            fail_q    <= 1'b0;
        end else begin
            pending_q <= pending_d;
            pass_q    <= pass_d;
            fail_q    <= fail_d;
        end
    end

    {{ signal_type(verilog_mode) }} attempt_fired_q;
{{ attempt_fired_logic(verilog_mode, clock_edge, clock_signal, "start") }}

    assign active        = disable_i ? 1'b0 : (|pending_q);
    assign pass          = disable_i ? 1'b0 : pass_q;
    assign fail          = disable_i ? 1'b0 : fail_q;
    // The age-vector representation has exact capacity for one new attempt on
    // every cycle, so this specialization cannot exhaust a thread allocator.
    assign overflow_flag = 1'b0;
    assign attempt_fired = attempt_fired_q;
    assign disabled_o    = disable_i;

endmodule
