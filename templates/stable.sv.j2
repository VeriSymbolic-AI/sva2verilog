// Generated by sva2rtl {{ sva2rtl_version }}
// Source: {{ source_loc }}
// Original property: @({{ clock_edge }} {{ clock_signal }}) {{ original_text }}
module {{ module_name }} (
{% if verilog_mode %}
    input  {{ clock_signal }},
    input  rst_n,
    input  start,
    input  {{ signal_name }},
    input  disable_i,
    output active,
    output pass,
    output fail,
    output attempt_fired,
    output disabled_o
{% else %}
    input  logic {{ clock_signal }},
    input  logic rst_n,
    input  logic start,
    input  logic {{ signal_name }},
    input  logic disable_i,
    output logic active,
    output logic pass,
    output logic fail,
    output logic attempt_fired,
    output logic disabled_o
{% endif %}
);

    // ── Edge-detect registers ─────────────────────────────────────────────────
{% if verilog_mode %}
    reg sig_prev_q;
    reg attempt_fired_q;

    always @({{ clock_edge }} {{ clock_signal }}) begin
{% else %}
    logic sig_prev_q;
    logic attempt_fired_q;

    always_ff @({{ clock_edge }} {{ clock_signal }}) begin
{% endif %}
        if (!rst_n || disable_i) begin
            sig_prev_q      <= 1'b0;
            attempt_fired_q <= 1'b0;
        end else begin
            sig_prev_q      <= {{ signal_name }};
            attempt_fired_q <= attempt_fired_q | start;  // sticky
        end
    end

    // ── Detection logic ───────────────────────────────────────────────────────
    // $stable: signal unchanged since previous clock edge (XNOR)
{% if verilog_mode %}
    wire stable_detect;
{% else %}
    logic stable_detect;
{% endif %}
    assign stable_detect = ({{ signal_name }} == sig_prev_q);

    // ── Output logic ──────────────────────────────────────────────────────────
{% if verilog_mode %}
    wire pass_internal;
    wire fail_internal;
{% else %}
    logic pass_internal;
    logic fail_internal;
{% endif %}

    assign pass_internal = start & stable_detect;
    assign fail_internal = start & ~stable_detect;

    assign active        = disable_i ? 1'b0 : start;
    assign pass          = disable_i ? 1'b0 : pass_internal;
    assign fail          = disable_i ? 1'b0 : fail_internal;
    assign attempt_fired = attempt_fired_q;
    assign disabled_o    = disable_i;

endmodule
